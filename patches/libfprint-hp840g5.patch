+gboolean
+validity_fwext_parse_probe_response (const guint8 *response,
+                                      gsize         response_len,
+                                      gboolean     *loaded,
+                                      GError      **error)
+{
+  guint16 status = 0;
+
+  g_return_val_if_fail (loaded != NULL, FALSE);
+  *loaded = FALSE;
+
+  if (!response || response_len < 2)
+    {
+      g_set_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_PROTO,
+                   "GET_FW_INFO response has no complete status (%" G_GSIZE_FORMAT " bytes)",
+                   response_len);
+      return FALSE;
+    }
+
+  validity_unpack (response, response_len, "h", &status);
+  if (status == VCSFW_STATUS_OK)
+    {
+      *loaded = TRUE;
+      return TRUE;
+    }
+  if (status == VCSFW_STATUS_NO_FW)
+    return TRUE;
+
+  g_set_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_PROTO,
+               "GET_FW_INFO returned error status 0x%04x; refusing firmware upload",
+               status);
+  return FALSE;
+}
