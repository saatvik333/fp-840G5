+/* ================================================================
+ * Cancellation: exercise the production cleanup runner with real parent and
+ * child FpiSsms. The fake transport leaves every command pending until the
+ * test supplies a response/error, so early completion is observable.
+ * ================================================================ */
+
+typedef struct
+{
+  gboolean     enrolling;
+  gboolean     pending_writes;
+  gboolean     boundary_cancel;
+  gboolean     cancel_before_error;
+  gint         action_state;
+  gint         start_cleanup;
+  gint         num_states;
+  GError      *initial_error;
+  GCancellable *cancellable;
+  GPtrArray   *commands;
+  FpiSsm      *pending_child;
+  gboolean     completed;
+  GError      *error;
+} CancelTest;
+
+static void
+cancel_test_child_wait (FpiSsm   *ssm,
+                        FpDevice *dev)
+{
+  /* No device I/O: completion is supplied by cancel_test_finish(). */
+  g_assert_true (FP_IS_DEVICE (dev));
+  g_assert_cmpint (fpi_ssm_get_cur_state (ssm), ==, 0);
+}
+
+static void
+cancel_test_send (FpiSsm       *ssm,
+                  const guint8 *cmd,
+                  gsize         cmd_len)
+{
+  CancelTest *test = fpi_ssm_get_data (ssm);
+
+  g_assert_false (test->completed);
+  g_assert_null (test->pending_child);
+  g_assert_true (validity_classify_error (fpi_ssm_get_error (ssm), FALSE) == VALIDITY_ERR_CANCELLED ||
+                 g_cancellable_is_cancelled (test->cancellable));
+  g_ptr_array_add (test->commands, g_bytes_new (cmd, cmd_len));
+
+  test->pending_child = fpi_ssm_new (fpi_ssm_get_device (ssm),
+                                    cancel_test_child_wait, 1);
+  fpi_ssm_start_subsm (ssm, test->pending_child);
+}
+
+static void
+cancel_test_run_state (FpiSsm   *ssm,
+                       FpDevice *dev)
+{
+  CancelTest *test = fpi_ssm_get_data (ssm);
+  gint state = fpi_ssm_get_cur_state (ssm);
+
+  g_assert_true (FP_IS_DEVICE (dev));
+  if (state >= test->start_cleanup)
+    {
+      validity_cancel_cleanup_run_state (ssm, test->start_cleanup,
+                                          test->enrolling, test->pending_writes,
+                                          test->cancellable,
+                                          cancel_test_send);
+      return;
+    }
+
+  if (state == 0 && test->action_state != 0)
+    {
+      fpi_ssm_jump_to_state (ssm, test->action_state);
+      return;
+    }
+  g_assert_cmpint (state, ==, test->action_state);
+
+  if (test->boundary_cancel)
+    {
+      g_assert_false (validity_action_check_cancel (ssm, test->cancellable));
+      g_cancellable_cancel (test->cancellable);
+      g_assert_true (validity_action_check_cancel (ssm, test->cancellable));
+    }
+  else if (test->initial_error)
+    {
+      if (test->cancel_before_error)
+        g_cancellable_cancel (test->cancellable);
+      fpi_ssm_mark_failed (ssm, g_steal_pointer (&test->initial_error));
+    }
+  else
+    fpi_ssm_mark_completed (ssm);
+}
+
+static void
+cancel_test_done (FpiSsm   *ssm,
+                  FpDevice *dev,
+                  GError   *error)
+{
+  CancelTest *test = fpi_ssm_get_data (ssm);
+
+  g_assert_null (test->pending_child);
+  g_assert_false (test->completed);
+  test->completed = TRUE;
+  test->error = validity_cancel_error (error, test->cancellable);
+}
+
+static void
+cancel_test_start (CancelTest *test,
+                   FpDevice   *dev)
+{
+  FpiSsm *ssm;
+
+  test->start_cleanup = test->enrolling ? ENROLL_CANCEL_CAPTURE_STOP : VERIFY_CANCEL_CAPTURE_STOP;
+  test->num_states = test->enrolling ? ENROLL_NUM_STATES : VERIFY_NUM_STATES;
+  test->commands = g_ptr_array_new_with_free_func ((GDestroyNotify) g_bytes_unref);
+  test->cancellable = g_cancellable_new ();
+  ssm = fpi_ssm_new_full (dev, cancel_test_run_state, test->num_states,
+                         test->start_cleanup, "VALIDITY_CANCEL_TEST");
+  fpi_ssm_set_data (ssm, test, NULL);
+  fpi_ssm_start (ssm, cancel_test_done);
+}
+
+static void
+cancel_test_finish (CancelTest *test,
+                    gint        fail_command)
+{
+  const guint8 stop[] = { 0x04 };
+  const guint8 cleanups[] = { 0x1a };
+  const guint8 match_end[] = { 0x62, 0, 0, 0, 0 };
+  const guint8 enroll_end[] = { 0x69, 0, 0, 0, 0 };
+  const guint8 led_off_prefix[] = { 0x39, 0xf4, 0x01, 0, 0, 0xf4, 0x01, 0, 0 };
+  gboolean commit = test->enrolling && test->pending_writes;
+  guint count = commit ? 4 : 3;
+
+  for (guint i = 0; i < count; i++)
+    {
+      const guint8 *cmd;
+      gsize len;
+      FpiSsm *child;
+
+      /* Stop/Release must still be waiting, including during LED-off. */
+      g_assert_false (test->completed);
+      g_assert_nonnull (test->pending_child);
+      g_assert_cmpuint (test->commands->len, ==, i + 1);
+      cmd = g_bytes_get_data (g_ptr_array_index (test->commands, i), &len);
+      if (i == 0)
+        g_assert_cmpmem (cmd, len, stop, sizeof (stop));
+      else if (commit && i == 1)
+        g_assert_cmpmem (cmd, len, cleanups, sizeof (cleanups));
+      else if (i == count - 2)
+        {
+          if (test->enrolling)
+            g_assert_cmpmem (cmd, len, enroll_end, sizeof (enroll_end));
+          else
+            g_assert_cmpmem (cmd, len, match_end, sizeof (match_end));
+        }
+      else
+        {
+          g_assert_cmpuint (len, >, sizeof (led_off_prefix));
+          g_assert_cmpmem (cmd, sizeof (led_off_prefix),
+                           led_off_prefix, sizeof (led_off_prefix));
+        }
+
+      child = g_steal_pointer (&test->pending_child);
+      if ((gint) i == fail_command)
+        fpi_ssm_mark_failed (child,
+                             g_error_new_literal (G_USB_DEVICE_ERROR,
+                                                  G_USB_DEVICE_ERROR_NO_DEVICE,
+                                                  "secondary cleanup failure"));
+      else
+        fpi_ssm_mark_completed (child);
+    }
+
+  g_assert_true (test->completed);
+  g_assert_null (test->pending_child);
+  g_assert_cmpuint (test->commands->len, ==, count);
+  g_assert_error (test->error, G_IO_ERROR, G_IO_ERROR_CANCELLED);
+  /* Neither a failed capture-stop nor later cleanup may replace this error
+   * with REMOVED/NO_DEVICE or start a reconnect/reset. */
+  if (!test->boundary_cancel && !test->cancel_before_error)
+    g_assert_cmpstr (test->error->message, ==, "original action cancellation");
+}
+
+static void
+cancel_test_clear (CancelTest *test)
+{
+  g_assert_null (test->pending_child);
+  g_clear_error (&test->initial_error);
+  g_clear_error (&test->error);
+  g_clear_object (&test->cancellable);
+  g_clear_pointer (&test->commands, g_ptr_array_unref);
+}
+
+static void
+test_cancel_verify_wait (void)
+{
