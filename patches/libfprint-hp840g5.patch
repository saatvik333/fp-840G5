+    }
+
+  /* Even a success/no-op cleanup must have its complete status-only shape. */
+  g_assert_cmpint (validity_pair_hp_preflight_next (PAIR_AB_BOOTSTRAP_CLEANUPS_RECV,
+                                                   0, reg, 1),
+                   ==, PAIR_NUM_STATES);
+  g_assert_cmpint (validity_pair_hp_preflight_next (PAIR_AB_BOOTSTRAP_CLEANUPS_RECV,
+                                                   0x0491, reg, 1),
+                   ==, PAIR_NUM_STATES);
+}
+
+static void
+test_pair_hp_preflight_unexpected_states (void)
+{
+  /* Neither starting a send nor jumping to reset/partition can count as a
+   * validated preflight response. Unknown enum values must fail closed. */
+  const ValidityPairSsmState states[] = {
+    PAIR_GET_FLASH_INFO_RECV, PAIR_VERIFY_TLS_RECV,
+    PAIR_AB_BOOTSTRAP_ROM_SEND, PAIR_AB_BOOTSTRAP_IDENTIFY_SEND,
+    PAIR_AB_BOOTSTRAP_WRITE_REG_SEND, PAIR_AB_BOOTSTRAP_READ_REG_SEND,
+    PAIR_AB_BOOTSTRAP_REIDENTIFY_SEND, PAIR_AB_BOOTSTRAP_CLEANUPS_SEND,
+    PAIR_SEND_RESET_BLOB, PAIR_PARTITION_FLASH_SEND,
+    PAIR_NUM_STATES, (ValidityPairSsmState) -1,
+  };
+
+  for (guint i = 0; i < G_N_ELEMENTS (states); i++)
+    g_assert_cmpint (validity_pair_hp_preflight_next (states[i], 0, NULL, 0),
+                     ==, PAIR_NUM_STATES);
+}
