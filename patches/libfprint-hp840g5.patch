+  const guint8 *payloads[] = { rom, identity, NULL, reg, identity, NULL };
+  const gsize lengths[] = { sizeof (rom), sizeof (identity), 0,
+                           sizeof (reg), sizeof (identity), 0 };
+
+  make_hp_preflight_rom (rom);
+  make_hp_preflight_identity (identity);
+  FP_WRITE_UINT32_LE (reg, 2);
+  for (guint i = 0; i < G_N_ELEMENTS (states); i++)
