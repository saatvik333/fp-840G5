+/* The only captured factory-empty 138a:00ab bootstrap is PR #256's
+ * ROM 6.7/build 164/product 48 and 0x0190:0x0070 identity (0xd51,
+ * 57K0 FM-154-120). In particular, the same USB ID's 0x969 variant is
+ * not admitted. The ROM response's complete captured payload is 36 bytes;
+ * identify is exactly 8 bytes. No serial number is part of the gate.
+ * Reference: python-validity 128a9eb, init_flash.py / clean_slate_probe.py. */
+ValidityPairSsmState
+validity_pair_hp_preflight_next (ValidityPairSsmState state,
+                                 guint16              status,
+                                 const guint8        *data,
+                                 gsize                data_len)
+{
+  if ((data_len > 0 && data == NULL) ||
+      (status != VCSFW_STATUS_OK &&
+       !(state == PAIR_AB_BOOTSTRAP_CLEANUPS_RECV && status == 0x0491)))
+    return PAIR_NUM_STATES;
+
+  /* All non-preflight states intentionally reach the refusal below. */
+  switch ((gint) state)
+    {
+    case PAIR_AB_BOOTSTRAP_ROM_RECV:
+      {
+        ValidityVersionInfo version = { 0 };
+
+        if (data_len != 36 || !vcsfw_parse_version (data, data_len, &version) ||
+            version.build_time != 1415491824 || version.build_num != 164 ||
+            version.version_major != 6 || version.version_minor != 7 ||
+            version.product != 48)
+          return PAIR_NUM_STATES;
+
+        return PAIR_AB_BOOTSTRAP_IDENTIFY_SEND;
+      }
+
+    case PAIR_AB_BOOTSTRAP_IDENTIFY_RECV:
+    case PAIR_AB_BOOTSTRAP_REIDENTIFY_RECV:
+      {
+        ValiditySensorIdent identity = { 0 };
+
